# LLM (API compatível com OpenAI: Ollama local, LM Studio, etc.)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# Vazio -> usa LLM_MODEL. O modelo do supervisor precisa suportar structured output.
SUPERVISOR_MODEL=
LLM_TEMPERATURE=0.0

# Orquestração do grafo
MAX_TOOL_STEPS=6
RECURSION_LIMIT=25

# Banco e autenticação
DATABASE_URL=postgresql+psycopg://gestlog:gestlog@localhost:5432/gestlog
AUTH_SECRET=dev-secret-change-me
AUTH_COOKIE_NAME=gestlog_auth
# Em produção (HTTPS) mantenha true; em http local use false
AUTH_COOKIE_SECURE=true
SESSION_EXPIRE_MINUTES=1440

# Logs
LOG_LEVEL=INFO
